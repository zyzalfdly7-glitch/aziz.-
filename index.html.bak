    <script src="../../js/charts.js"></script>
    <script src="../../js/export.js"></script>
    <script src="../../js/components/toast.js?v=3"></script>
    <script src="../../js/components/modal.js?v=3"></script>
    <script src="../../js/components/sidebar.js"></script>
    <script src="../../js/components/table.js"></script>
    <script src="../../js/components/tabs.js"></script>
    <script src="../../js/components/dropdown.js"></script>
    <script src="../../js/components/pagination.js"></script>
    <script src="../../js/components/form-builder.js"></script>
    <script src="../../js/components/chart.js"></script>
    <script src="../../js/components/breadcrumb.js"></script>
    <script src="../../js/components/empty-state.js"></script>
    <script src="../../js/modules/students.js"></script>
    <script src="../../js/modules/teachers.js"></script>
    <script src="../../js/modules/grades.js"></script>
    <script src="../../js/modules/attendance.js"></script>
    <script src="../../js/modules/payments.js"></script>
    <script src="../../js/modules/announcements.js"></script>
    <script src="../../js/modules/registrations.js"></script>
    <script src="../../js/app.js"></script>
    
        <script>
            (function() {
                App.Auth.requireAuth(['admin']);
                const user = App.Auth.getCurrentUser();
                document.getElementById('welcome-message').textContent = `ظ…ط±ط­ط¨ظ‹ط§طŒ ${user.name.split(' ')[0]}`;
                document.getElementById('current-date').textContent = App.Utils.formatDate(new Date());
                
                if (App.DB && App.DB.getAll) {
                    document.getElementById('stat-students').textContent = App.DB.count ? App.DB.count('students') : (App.DB.getAll('students')||[]).length;
                    document.getElementById('stat-teachers').textContent = App.DB.count ? App.DB.count('teachers') : (App.DB.getAll('teachers')||[]).length;
                    document.getElementById('stat-classes').textContent = App.DB.count ? App.DB.count('classes') : (App.DB.getAll('classes')||[]).length;
                    
                    const registrations = App.DB.getAll('registrations') || [];
                    document.getElementById('stat-registrations').textContent = registrations.filter(r => r.status === 'pending' || r.status === 'ظ‚ظٹط¯ ط§ظ„ط§ظ†طھط¸ط§ط±').length;
                    
                    const payments = App.DB.getAll('payments') || [];
                    const paid = payments.filter(p => p.status === 'paid' || p.status === 'ظ…ط¯ظپظˆط¹').reduce((acc, p) => acc + (Number(p.amount) || 0), 0);
                    const unpaid = payments.filter(p => p.status !== 'paid' && p.status !== 'ظ…ط¯ظپظˆط¹').reduce((acc, p) => acc + (Number(p.amount) || 0), 0);
                    
                    const formatCur = App.Utils && App.Utils.formatCurrency ? App.Utils.formatCurrency : (v) => v + ' ط±.ط³';
                    document.getElementById('stat-paid').textContent = formatCur(paid);
                    document.getElementById('stat-unpaid').textContent = formatCur(unpaid);
                    
                    const attendance = App.DB.getAll('attendance') || [];
                    const today = new Date().toISOString().split('T')[0];
                    const todayAtt = attendance.filter(a => a.date === today);
                    if (todayAtt.length > 0) {
                        const present = todayAtt.filter(a => a.status === 'present' || a.status === 'ط­ط§ط¶ط±').length;
                        document.getElementById('stat-attendance').textContent = ((present / todayAtt.length) * 100).toFixed(1) + '%';
                    } else {
                        document.getElementById('stat-attendance').textContent = 'ظ„ط§ طھظˆط¬ط¯ ط¨ظٹط§ظ†ط§طھ';
                    }
                    
                    document.getElementById('stat-announcements').textContent = App.DB.count ? App.DB.count('announcements') : (App.DB.getAll('announcements')||[]).length;

                    const tbody = document.getElementById('registrations-tbody');
                    if (tbody) {
                        const recentRegs = [...registrations].sort((a,b) => new Date(b.createdAt||0) - new Date(a.createdAt||0)).slice(0, 5);
                        if (recentRegs.length === 0) {
                            tbody.innerHTML = '<tr><td colspan="3" class="text-center text-gray" style="padding:10px;">ظ„ط§ طھظˆط¬ط¯ ط·ظ„ط¨ط§طھ</td></tr>';
                        } else {
                            tbody.innerHTML = recentRegs.map(r => `<tr><td style="padding:10px;">${r.studentName}</td><td style="padding:10px;">${App.Utils.formatDate(r.createdAt || new Date())}</td><td style="padding:10px;"><span class="badge ${r.status === 'pending' || r.status === 'ظ‚ظٹط¯ ط§ظ„ط§ظ†طھط¸ط§ط±' ? 'badge--warning' : 'badge--success'}">${r.status}</span></td></tr>`).join('');
                        }
                    }

                    const annList = document.getElementById('announcements-list');
                    if (annList) {
                        const announcements = App.DB.getAll('announcements') || [];
                        const recentAnns = [...announcements].sort((a,b) => new Date(b.createdAt||0) - new Date(a.createdAt||0)).slice(0, 5);
                        if (recentAnns.length === 0) {
                            annList.innerHTML = '<li class="text-center text-gray" style="padding:10px;">ظ„ط§ طھظˆط¬ط¯ ط¥ط¹ظ„ط§ظ†ط§طھ</li>';
                        } else {
                            annList.innerHTML = recentAnns.map(a => `<li style="padding: 10px; border-bottom: 1px solid #eee;"><strong>${a.title}</strong><br><small class="text-gray" style="color:#666;">${App.Utils.formatDate(a.createdAt || new Date())}</small></li>`).join('');
                        }
                    }
                }
                
                if (window.Chart) {
                    const classes = (App.DB && App.DB.getAll) ? App.DB.getAll('classes') || [] : [];
                    const students = (App.DB && App.DB.getAll) ? App.DB.getAll('students') || [] : [];
                    
                    const classLabels = classes.map(c => c.name);
                    const classData = classes.map(c => students.filter(s => s.classId === c.id).length);
                    
                    const ctxStudents = document.getElementById('students-chart');
                    if (ctxStudents) {
                        new Chart(ctxStudents, {
                            type: 'bar',
                            data: {
                                labels: classLabels.length ? classLabels : ['ظ„ط§ طھظˆط¬ط¯ ظپطµظˆظ„'],
                                datasets: [{
                                    label: 'ط¹ط¯ط¯ ط§ظ„ط·ظ„ط§ط¨',
                                    data: classLabels.length ? classData : [0],
                                    backgroundColor: 'rgba(13, 110, 253, 0.7)'
                                }]
                            }
                        });
                    }
                    
                    const payments = (App.DB && App.DB.getAll) ? App.DB.getAll('payments') || [] : [];
                    const paidCount = payments.filter(p => p.status === 'paid' || p.status === 'ظ…ط¯ظپظˆط¹').length;
                    const unpaidCount = payments.length - paidCount;
                    
                    const ctxFees = document.getElementById('fees-chart');
                    if (ctxFees) {
                        new Chart(ctxFees, {
                            type: 'pie',
                            data: {
                                labels: ['ظ…ط¯ظپظˆط¹', 'ط؛ظٹط± ظ…ط¯ظپظˆط¹'],
                                datasets: [{
                                    data: [paidCount, unpaidCount],
                                    backgroundColor: ['#198754', '#dc3545']
                                }]
                            }
                        });
                    }
                }
            })();
        </script>
</body>
